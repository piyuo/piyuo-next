{
  "name": "piyuo-next",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "workers:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --port 8080",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "i18n:convert": "node scripts/csv-to-locale.js",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@next/third-parties": "^15.5.21",
    "@tailwindcss/typography": "^0.5.20",
    "csv-parse": "^6.1.0",
    "highlight.js": "^11.11.1",
    "next": "15.5.21",
    "next-intl": "^4.13.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "jest": "30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jest-environment-node": "^30.0.5",
    "only-allow": "^1.2.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2",
    "whatwg-fetch": "^3.6.20",
    "wrangler": "^4.110.0",
    "yaml": "^2.8.0"
  },
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "engineStrict": true,
  "x-notes": {
    "deploy": "merge release-please branch into main to trigger deployment.",
    "workers:build": "must not changed to `build` as it is required for Cloudflare workers deployment.",
    "typescript": "pin to 5.8.3 to avoid minor version surprises across environments.",
    "jest": "pin to 30.0.3 to avoid minor version surprises across environments.",
    "node": "Pinned to v22 for long-term LTS support. Consider upgrading to v24 in Oct 2025 when it becomes LTS.",
    "pnpm": "Using Corepack + pnpm@11.13.0 for consistent builds across dev and CI. run corepack enable | corepack prepare pnpm@11.13.0 --activate to set up."
  }
}
